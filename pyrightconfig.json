{
  "pythonVersion": "3.10",
  "typeCheckingMode": "basic",
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/dist",
    "**/.next",
    "apps/airflow",
    "apps/marrow/dags"
  ],
  "extraPaths": [
    "libs/backend/core/src",
    "libs/backend/db/src",
    "libs/backend/storage/src",
    "libs/backend/testing/src"
  ],
  "executionEnvironments": [
    {
      "root": "apps/marrow/backend",
      "pythonVersion": "3.11",
      "extraPaths": [
        "apps/marrow/backend",
        "libs/backend/core/src",
        "libs/backend/db/src",
        "libs/backend/storage/src",
        "libs/backend/testing/src"
      ]
    },
    {
      "root": "apps/firstout/backend",
      "pythonVersion": "3.11",
      "extraPaths": [
        "apps/firstout/backend",
        "libs/backend/core/src",
        "libs/backend/db/src",
        "libs/backend/storage/src",
        "libs/backend/testing/src"
      ]
    },
    {
      "root": "apps/dk/tag-printer/backend",
      "pythonVersion": "3.11",
      "extraPaths": ["apps/dk/tag-printer/backend"]
    }
  ]
}
