{
  "name": "buycycle-backend",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "platform:rust",
    "scope:buycycle"
  ],
  "implicitDependencies": [
    "f0rge-api-errors",
    "f0rge-identity"
  ],
  "targets": {
    "format-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "rust",
        "^rust"
      ],
      "outputs": [],
      "options": {
        "command": "node .github/rust/run-target.mjs format-check apps/buycycle/backend"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "rust",
        "^rust"
      ],
      "outputs": [],
      "options": {
        "command": "node .github/rust/run-target.mjs lint apps/buycycle/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "rust",
        "^rust"
      ],
      "outputs": [],
      "options": {
        "command": "node .github/rust/run-target.mjs test apps/buycycle/backend"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "rust",
        "^rust"
      ],
      "outputs": [],
      "options": {
        "command": "node .github/rust/run-target.mjs build apps/buycycle/backend"
      }
    },
    "openapi": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo run --locked --manifest-path apps/buycycle/backend/Cargo.toml --target-dir target/nx/buycycle-backend --bin export-contract -- apps/buycycle/backend/openapi.json"
      }
    },
    "container-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "rust",
        "^rust",
        "buycycleImage"
      ],
      "outputs": [],
      "options": {
        "command": "python3 apps/buycycle/ops/image_rehearsal.py --output \"${BUYCYCLE_IMAGE_OUTPUT:-/tmp/f0rge-buycycle-image}\""
      }
    }
  },
  "namedInputs": {
    "buycycleImage": [
      "{workspaceRoot}/apps/buycycle/frontend/**/*",
      "{workspaceRoot}/libs/primer/**/*",
      "{workspaceRoot}/apps/buycycle/ops/**/*",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json"
    ]
  }
}
