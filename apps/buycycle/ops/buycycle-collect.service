[Unit]
Description=Buycycle bounded daily Rust collection
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/etc/buycycle/collector-activation.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/f0rge/apps/buycycle/ops/job-status.py --job collector -- /opt/f0rge/apps/buycycle/ops/collect-daily.sh
# Timeout applies to the dispatch client. Rust/PostgreSQL still retain quota and
# pending/blocked state if interrupted; never reset state to force a retry.
TimeoutStartSec=5h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/run/docker.sock -/run/buycycle-alerts
RestrictAddressFamilies=AF_UNIX
MemoryMax=128M
CPUQuota=25%
StandardOutput=journal
StandardError=journal

# Privileged host control plane; never mount Docker socket into the app.
