[Unit]
Description=Buycycle encrypted PostgreSQL snapshot
After=network.target
ConditionPathExists=/etc/buycycle/backup.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/f0rge/apps/buycycle/ops/job-status.py --job backup -- /opt/f0rge/apps/buycycle/ops/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/buycycle -/run/buycycle-alerts
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
TimeoutStartSec=2h
MemoryMax=256M
CPUQuota=50%
StandardOutput=journal
StandardError=journal

# Install/enable only in an approved cutover after custody/cadence review.
