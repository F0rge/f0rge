[Unit]
Description=Buycycle read-only operational signals
After=docker.service
Requires=docker.service
ConditionPathExists=/etc/buycycle/monitor.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/f0rge/apps/buycycle/ops/monitor.py --config /etc/buycycle/monitor.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
TimeoutStartSec=5min
MemoryMax=128M
CPUQuota=25%
StandardOutput=journal
StandardError=journal

# Read-only Docker queries still require privileged host socket access; no app grant.
