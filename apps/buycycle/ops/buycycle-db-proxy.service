[Unit]
Description=Buycycle backup proxy to the verified existing PostgreSQL cluster
Requires=buycycle-db-proxy.socket
After=buycycle-db-proxy.socket

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --connections-max=4 REPLACE_WITH_VERIFIED_PRIVATE_IPV4:5432
DynamicUser=true
User=buycycle-db-proxy
Group=buycycle-db-proxy
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=REPLACE_WITH_VERIFIED_PRIVATE_IPV4/32
MemoryMax=32M
TasksMax=8
UMask=0077
StandardOutput=journal
StandardError=journal

# Private target substitution is required; do not enable this draft unchanged.
