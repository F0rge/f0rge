{
  "name": "marrow-frontend",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/marrow/frontend",
  "implicitDependencies": ["marrow-backend"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/marrow/frontend",
        "command": "npm run typecheck"
      }
    },
    "codegen:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["marrow-backend:openapi"],
      "options": {
        "cwd": "apps/marrow/frontend",
        "command": "npm run codegen:api && git diff --exit-code lib/api/generated/schema.ts openapi.json ../backend/openapi.json"
      }
    }
  },
  "tags": ["platform:ts", "scope:marrow"]
}
