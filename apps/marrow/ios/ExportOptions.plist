<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used by `xcodebuild -exportArchive` to upload a TestFlight/App Store build.
	     Replace teamID with the 10-char Team ID (same value as DEVELOPMENT_TEAM
	     in Config/Shared.xcconfig) after Apple Developer Program enrollment. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>REPLACE_WITH_TEAM_ID</string>
</dict>
</plist>
