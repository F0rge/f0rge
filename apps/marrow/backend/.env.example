JWT_SECRET=

# --- Fly.io deployment (see fly.toml at repo root) ---
# Set via `fly secrets set` — never commit real values.
# DATABASE_URL=                    # fly mpg attach sets this (use direct URL for asyncpg)
# MCP_READONLY_DATABASE_URL=       # read-only role for MCP app
# HEALTHTRACKER_RO_PASSWORD=       # consumed by migration 004
# JWT_SECRET=                      # Phase 5+ email/password auth
# AWS_ACCESS_KEY_ID=               # Tigris (fly storage create)
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# AWS_REGION=auto
# BUCKET_NAME=
# DEFAULT_STORAGE_USER_ID=00000000-0000-0000-0000-000000000001
# Where uploaded photos are written. Containers mount a volume here
# (docker-compose.*.yml sets /app/photos). For local dev use a relative
# path like `photos` (the app default) so it lands in backend/photos/.
PHOTO_DIR=/app/photos
DATABASE_URL=postgresql+asyncpg://health:health@localhost:5432/health
APP_TIMEZONE=Europe/Luxembourg
POSTGRES_PASSWORD=health
SETTINGS_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000
OPENWEATHERMAP_API_KEY=
OPENWEATHERMAP_CITY=Luxembourg
WEATHER_FETCH_ENABLED=true
HEALTH_IMPORT_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
FOOD_ANALYSIS_ENABLED=true

# Consumed by migration 019 to create/set the healthtracker_app role password.
# Runtime DATABASE_URL for backend, embedding-worker, and MCP main session on Pi.
HEALTHTRACKER_APP_PASSWORD=

# MCP server (issue #49)
# Long random secret used by Alembic migration 004 to set the role password,
# and by docker-compose.prod.yml to construct MCP_READONLY_DATABASE_URL.
HEALTHTRACKER_RO_PASSWORD=
# asyncpg URL for the read-only role. Used by the MCP server container only.
# Example: postgresql+asyncpg://healthtracker_ro:${HEALTHTRACKER_RO_PASSWORD}@postgres:5432/health
MCP_READONLY_DATABASE_URL=
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8005
EMBEDDING_WORKER_POLL_INTERVAL_SECONDS=5
EMBEDDING_WORKER_BATCH_SIZE=10
EMBEDDING_WORKER_MAX_ATTEMPTS=5
