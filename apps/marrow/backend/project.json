{
  "name": "marrow-backend",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/marrow/backend",
  "targets": {
    "image": {},
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/marrow/backend",
        "command": "uvx ruff@0.16.1 check ."
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/marrow/backend",
        "command": "uvx ruff@0.16.1 format --check ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/marrow/backend",
        "command": "uv run pytest -ra"
      }
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/marrow/backend",
        "command": "uv export --frozen --no-dev --no-hashes --no-emit-local -o /tmp/marrow-req.txt && uvx pip-audit -r /tmp/marrow-req.txt --no-deps --disable-pip"
      }
    },
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    },
    "openapi": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/marrow/backend",
        "command": "uv run python scripts/export_openapi.py"
      },
      "outputs": [
        "{projectRoot}/openapi.json",
        "{workspaceRoot}/apps/marrow/frontend/openapi.json"
      ]
    }
  },
  "tags": ["platform:py", "scope:marrow"],
  "metadata": {
    "deploy": {
      "host": "railway",
      "services": [
        {
          "name": "marrow-api",
          "healthcheckPath": "/api/v1/health",
          "preDeployCommand": "/bin/sh -c 'DATABASE_URL=\"${MIGRATION_DATABASE_URL:-$DATABASE_URL}\" uv run alembic upgrade head'",
          "startCommand": "uv run uvicorn app.main:app --host 0.0.0.0 --port 8000"
        },
        { "name": "marrow-worker", "startCommand": "uv run python -m app.embedding_pipeline" },
        { "name": "marrow-mcp", "startCommand": "/app/apps/marrow/backend/.venv/bin/python -m app.mcp --transport streamable-http" }
      ],
      "check": {
        "port": 8000,
        "postgres": "pgvector/pgvector:pg16",
        "env": {
          "DATABASE_URL": "postgresql+asyncpg://f0rge:f0rge@postgres:5432/f0rge",
          "JWT_SECRET": "image-check-jwt-secret-32-chars-minimum",
          "SETTINGS_ENCRYPTION_KEY": "dGVzdC1rZXktMzJieXRzLWZvci1mZXJuZXQtMTIzNDU2Nzg=",
          "HEALTHTRACKER_RO_PASSWORD": "image-check-ro",
          "HEALTHTRACKER_APP_PASSWORD": "image-check-app",
          "FOOD_ANALYSIS_ENABLED": "false",
          "WEATHER_FETCH_ENABLED": "false"
        }
      }
    }
  }
}
