{
  "name": "marrow-backend",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/marrow/backend",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/marrow/backend",
        "command": "uvx ruff@0.16.1 check ."
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/marrow/backend",
        "command": "uvx ruff@0.16.1 format --check ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/marrow/backend",
        "command": "uv run pytest -ra"
      }
    },
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    },
    "openapi": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/marrow/backend",
        "command": "uv run python scripts/export_openapi.py"
      },
      "outputs": [
        "{projectRoot}/openapi.json",
        "{workspaceRoot}/apps/marrow/frontend/openapi.json"
      ]
    }
  },
  "tags": ["platform:py", "scope:marrow"]
}
