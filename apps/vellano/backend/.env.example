# Local only. Never reuse Marrow DATABASE_URL or ht-postgres.
# CORS_ORIGINS is list[str] parsed as JSON — omit it to use the default
# ["http://localhost:3003"]. A bare string crashes startup.
DATABASE_URL=postgresql+asyncpg://vellano:vellano@localhost:5433/vellano
DIRECT_DATABASE_URL=

# Required for login — use a long random string in local .env (not this placeholder).
JWT_SECRET=replace-with-a-long-random-secret

# Set true when serving over HTTPS (Railway develop/prod). Leave false for local HTTP.
COOKIE_SECURE=false

# Bootstrap owner when the users table is empty (idempotent).
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-owner

# Role users created on every startup when missing (idempotent).
SEED_TILL_PASSWORD=change-me-till
SEED_BOOKS_PASSWORD=change-me-books
SEED_WAREHOUSE_PASSWORD=change-me-warehouse
SEED_BUYER_PASSWORD=change-me-buyer

# Demo catalogue/PO path — off by default; set true for a coherent playground dataset.
SEED_PLAYGROUND=false

# Nia (LLM via OpenRouter) — vellano-api only; never commit a real key.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL is unused (pydantic-ai OpenRouterProvider has no base_url).
# GLM/OpenRouter reasoning (effort + exclude; closest "off" when mandatory):
# OPENROUTER_REASONING_EFFORT=low
# OPENROUTER_REASONING_EXCLUDE=true
# Lifespan ticker for scheduled Nia tasks (Postgres advisory lock; no extra service).
# NIA_SCHEDULE_TICKER=true

# Fernet key for SMTP/WhatsApp secrets in team_settings. Generate with:
#   uv run --project apps/vellano/backend python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Required to save or send mail. Set the same value on Railway vellano-api develop.
# SETTINGS_ENCRYPTION_KEY=

# Meta Cloud API webhook verify token (env, not Settings). Same value in the Meta app.
# WA_VERIFY_TOKEN=


# Local object storage (filesystem fallback). Files land under STORAGE_DIR relative to backend cwd.
STORAGE_DIR=storage
DEFAULT_STORAGE_USER_ID=vellano

# Platform (control-plane) database — never the same as DATABASE_URL.
# PLATFORM_DATABASE_URL=postgresql+asyncpg://vellano:vellano@localhost:5433/vellano_platform
# PLATFORM_DIRECT_DATABASE_URL=
# PLATFORM_ADMIN_DATABASE_URL=postgresql+asyncpg://vellano:vellano@localhost:5433/vellano
# TENANT_BASE_DOMAIN=localhost
# DEFAULT_TENANT_SLUG=vellano
# DEFAULT_TENANT_HOSTNAMES=["localhost"]
# SEED_DEV_EXTRAS=true
# LANDING_BASE_URL=http://localhost:3004
# PLATFORM_SIGNUP_MODE=instant
# PLATFORM_MAIL_MODE=log


# Object storage (Tigris). When BUCKET_NAME + AWS_* are set, uploads use S3;
# when unset, STORAGE_DIR filesystem fallback. Never reuse Marrow photos / photos-dev.
# AWS_ACCESS_KEY_ID=               # Tigris (fly storage create) or Railway bucket refs
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# AWS_REGION=auto
# BUCKET_NAME=
