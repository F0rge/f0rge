# Repo-root build context. Whitelist this app + sibling workspace manifests
# so root `npm ci` can resolve workspaces without shipping @f0rge/ui source.
*
!package.json
!package-lock.json
!apps
apps/*
!apps/marrow
apps/marrow/*
!apps/marrow/frontend
!apps/marrow/frontend/package.json
!apps/dk
apps/dk/*
!apps/dk/tag-printer
apps/dk/tag-printer/*
!apps/dk/tag-printer/frontend
!apps/dk/tag-printer/frontend/package.json
!apps/vellano
apps/vellano/*
!apps/vellano/frontend
!apps/vellano/frontend/package.json
!apps/vellano/landing
!libs
libs/*
!libs/ui
!libs/ui/package.json

apps/vellano/landing/node_modules
apps/vellano/landing/.next
apps/vellano/landing/out
apps/vellano/landing/build
apps/vellano/landing/dist
**/.env
**/.env.local
**/.env.*.local
**/.DS_Store
**/npm-debug.log*
**/.eslintcache
**/coverage
