{
  "name": "environment-monitor-backend",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/environment-monitor/backend",
  "targets": {
    "image": {},
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/environment-monitor/backend",
        "command": "python3 test_aggregation.py"
      }
    }
  },
  "tags": ["platform:py", "scope:envmon"],
  "metadata": {
    "deploy": {
      "host": "pi",
      "services": [{ "name": "environment-monitor-backend", "healthcheckPath": "/health" }],
      "build": { "context": "apps/environment-monitor/backend" },
      "check": {
        "port": 5001,
        "path": "/",
        "env": { "BLINKA_FORCEBOARD": "GENERIC_LINUX_PC", "BLINKA_FORCECHIP": "GENERIC_X86" }
      }
    }
  }
}
