{
  "name": "daskasas-commerce",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/storefront/commerce/src",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/storefront/commerce", "command": "npm run lint" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/storefront/commerce", "command": "npm run typecheck" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/storefront/commerce", "command": "npm run build" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/storefront/commerce", "command": "npm run test" }
    },
    "integration": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/storefront/commerce", "command": "node scripts/verify-live.mjs" }
    },
    "container-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^default", "{workspaceRoot}/package.json", "{workspaceRoot}/package-lock.json", "{workspaceRoot}/vendor/braces/**"],
      "options": { "command": "node apps/storefront/commerce/scripts/check-container.mjs" }
    }
  },
  "tags": ["platform:ts", "scope:daskasas"]
}
