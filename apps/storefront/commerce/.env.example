# DasKasas commerce. The app stays in apps/storefront.
# Runtime variables keep the STOREFRONT_ prefix. Leave the local database URL unchanged.
NODE_ENV=development
HOST=127.0.0.1
DATABASE_URL=postgres://storefront:storefront@localhost:5434/storefront
REDIS_URL=redis://localhost:6379
STORE_CORS=http://localhost:3004
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:3004
# Hosted runtime requires strong (at least 32-character) JWT, cookie, and BFF secrets.
JWT_SECRET=
COOKIE_SECRET=
FIRSTOUT_OPS_URL=http://localhost:8003/api/v1/ops-commerce/v1
FIRSTOUT_OPS_TOKEN=
FIRSTOUT_OPS_COMPANY_ID=
STOREFRONT_BFF_SECRET=
STOREFRONT_PUBLIC_URL=http://localhost:3004
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
STOREFRONT_CLERK_ISSUER=
STOREFRONT_CLERK_AUDIENCE=storefront
STOREFRONT_SENDGRID_API_KEY=
STOREFRONT_SENDGRID_FROM=
STOREFRONT_SENDGRID_ORDER_TEMPLATE_ID=
STOREFRONT_SENDGRID_STATUS_TEMPLATE_ID=
STOREFRONT_SENDGRID_REFUND_TEMPLATE_ID=
STOREFRONT_SYNC_CRON="* * * * *"
STOREFRONT_AVAILABILITY_MAX_AGE_SECONDS=300
STOREFRONT_HOLD_TTL_SECONDS=1200
STOREFRONT_VAT_RATE_PERCENT=15
# Set a server-owned JSON zone list only after operations approves real rates.
STOREFRONT_GAUTENG_DELIVERY_ZONES=
# Local checkout QA only; never enable on Railway or another hosted runtime.
STOREFRONT_TEST_PAYMENT_ENABLED=false
STOREFRONT_RUNTIME_KIND=local
# Paystack hosted checkout. Leave both values blank to keep it disabled; setting only one fails startup.
# Secret key: sk_test_... (or sk_live_... together with PAYSTACK_LIVE_ENABLED=true).
PAYSTACK_SECRET_KEY=
# Webhook signing secret (whsec_...) from Developers > API configuration. Point the dashboard
# webhook URL at https://<commerce host>/hooks/paystack.
PAYSTACK_WEBHOOK_SECRET=
# Explicit opt-in for a live key; any other value rejects sk_live_.
PAYSTACK_LIVE_ENABLED=false
# A test key is refused on a hosted runtime (anyone can pay with Paystack's public test cards).
# Set true only for a private hosted test-mode walkthrough, then remove it.
PAYSTACK_HOSTED_TEST_MODE=false
# Incident switch: true stops new refund requests while verified outcomes keep converging.
PAYSTACK_REFUNDS_PAUSED=false
