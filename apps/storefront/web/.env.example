MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3004
STOREFRONT_BFF_SECRET=
# Clerk customer auth. Configure the named template in Clerk before enabling.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
STOREFRONT_CLERK_JWT_TEMPLATE=storefront_medusa
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# Production preview only. Server-side Basic Auth credentials; keep out of NEXT_PUBLIC_*.
# Use a username without ':' and a password of at least 32 characters.
STOREFRONT_PREVIEW_USERNAME=
STOREFRONT_PREVIEW_PASSWORD=
STOREFRONT_INDEXING_ENABLED=false
STOREFRONT_RUNTIME_KIND=local
# Public PostHog Cloud EU project token (phc_...). Use an isolated test project, never production.
# Leave empty to keep consent controls without sending events.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
