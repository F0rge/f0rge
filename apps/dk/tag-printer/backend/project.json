{
  "name": "dk-tag-printer-backend",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/dk/tag-printer/backend",
  "targets": {
    "image": {},
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/dk/tag-printer/backend",
        "command": "uvx ruff@0.16.1 check ."
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/dk/tag-printer/backend",
        "command": "uvx ruff@0.16.1 format --check ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/dk/tag-printer/backend",
        "command": "uv run pytest -ra"
      }
    },
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    }
  },
  "tags": ["platform:py", "scope:dk"],
  "metadata": {
    "deploy": {
      "host": "pi",
      "services": [{ "name": "dk-tag-printer-backend", "healthcheckPath": "/health" }],
      "check": { "port": 8000 }
    }
  }
}
