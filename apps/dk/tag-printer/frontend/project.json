{
  "name": "dk-tag-printer-frontend",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/dk/tag-printer/frontend",
  "targets": {
    "image": {},
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/dk/tag-printer/frontend",
        "command": "npm run typecheck"
      }
    }
  },
  "tags": ["platform:ts", "scope:dk"],
  "metadata": {
    "deploy": {
      "host": "pi",
      "services": [{ "name": "dk-tag-printer-frontend", "healthcheckPath": "/" }],
      "build": { "args": { "NEXT_PUBLIC_API_URL": "https://tags-api.leo-figueiredo.com" } },
      "check": { "port": 3000 }
    }
  }
}
