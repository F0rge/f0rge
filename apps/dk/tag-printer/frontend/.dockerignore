# Repo-root build context. Whitelist this app + sibling workspace manifests
# so root `npm ci` can resolve workspaces.
*
!package.json
!package-lock.json
!apps
apps/*
!apps/marrow
apps/marrow/*
!apps/marrow/frontend
!apps/marrow/frontend/package.json
!apps/dk
apps/dk/*
!apps/dk/tag-printer
apps/dk/tag-printer/*
!apps/dk/tag-printer/frontend
!apps/firstout
apps/firstout/*
!apps/firstout/frontend
!apps/firstout/frontend/package.json
!libs
libs/*
!libs/ui
!libs/ui/package.json

apps/dk/tag-printer/frontend/node_modules
apps/dk/tag-printer/frontend/.next
apps/dk/tag-printer/frontend/out
apps/dk/tag-printer/frontend/build
apps/dk/tag-printer/frontend/dist
**/.env
**/.env.local
**/.env.*.local
**/.DS_Store
**/npm-debug.log*
**/.eslintcache
**/coverage
