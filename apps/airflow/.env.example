# Copy to .env and fill secrets. Never commit .env.
#
# Generate Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Local Mac (no pi overlay):
#   AIRFLOW_UID=$(id -u)
#   docker compose -p airflow up -d --build
#   UI: http://localhost:8080

AIRFLOW_UID=50000
POSTGRES_PASSWORD=change-me-postgres
AIRFLOW__CORE__FERNET_KEY=
# Shared across api-server + scheduler (+ workers). Required for LocalExecutor.
AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me-admin

# Optional overrides (Pi overlay already sets parallelism=2)
# AIRFLOW__CORE__PARALLELISM=16
# AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=16
# AIRFLOW_IMAGE_NAME=f0rge-airflow:3.0.3
