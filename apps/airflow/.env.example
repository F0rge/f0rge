# Copy to .env on the Pi and fill secrets. Never commit .env.
#
# Generate Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate JWT secret:
#   openssl rand -hex 32
#
# Boot (rpi):
#   export AIRFLOW_UID=1000
#   docker compose -p airflow up -d --build
#   UI: https://airflow.leo-figueiredo.com
#   Flower: http://100.103.61.77:5555

AIRFLOW_UID=1000
POSTGRES_PASSWORD=change-me-postgres
AIRFLOW__CORE__FERNET_KEY=
# Shared across api-server + scheduler + workers. Required for CeleryExecutor.
AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me-admin

# Optional overrides (compose defaults: parallelism=2, worker concurrency=2)
# AIRFLOW__CORE__PARALLELISM=2
# AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=2
# AIRFLOW__CELERY__WORKER_CONCURRENCY=2
# AIRFLOW_IMAGE_NAME=f0rge-airflow:3.1.7
#
# GitDagBundle clones public https://github.com/F0rge/f0rge.git.
# marrow_dev tracks develop; marrow_prod tracks main. airflow + dk stay on develop.
# Airflow 3.1+ git provider still requires git_default (empty creds OK for public HTTPS).
# AIRFLOW_CONN_GIT_DEFAULT={"conn_type":"git","host":"https://github.com/F0rge/f0rge.git"}

# --- Meal classification (common-ai) ---
# Celery worker calls Marrow resolve/complete/fail. DAG picks env from bundle path.
# MARROW_DEV_API_BASE_URL=https://api-dev.marrow-health.com
# MARROW_DEV_AIRFLOW_SERVICE_TOKEN=  # same value as develop Railway AIRFLOW_SERVICE_TOKEN
# MARROW_PROD_API_BASE_URL=https://api.marrow-health.com
# MARROW_PROD_AIRFLOW_SERVICE_TOKEN=  # distinct prod token — do not reuse develop's
#
# Airflow connections (JSON). Prefer setting via UI; env form works for boot:
# AIRFLOW_CONN_PYDANTICAI_OPENROUTER={"conn_type":"pydanticai","host":"https://openrouter.ai/api/v1","password":"<OPENROUTER_API_KEY>","extra":{"model":"openai:google/gemini-3-flash-preview"}}
# AIRFLOW_CONN_AWS_PHOTOS_DEV={"conn_type":"aws","login":"<DEV_AWS_ACCESS_KEY_ID>","password":"<DEV_AWS_SECRET_ACCESS_KEY>","extra":{"region_name":"auto","endpoint_url":"<DEV_AWS_ENDPOINT_URL_S3>","bucket_name":"<DEV_BUCKET_NAME>"}}
# AIRFLOW_CONN_AWS_PHOTOS_PROD={"conn_type":"aws","login":"<PROD_AWS_ACCESS_KEY_ID>","password":"<PROD_AWS_SECRET_ACCESS_KEY>","extra":{"region_name":"auto","endpoint_url":"<PROD_AWS_ENDPOINT_URL_S3>","bucket_name":"<PROD_BUCKET_NAME>"}}
