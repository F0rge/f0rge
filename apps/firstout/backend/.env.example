# Local only. Never reuse Marrow DATABASE_URL or ht-postgres.
# CORS_ORIGINS is list[str] parsed as JSON — omit it to use the default
# ["http://localhost:3003"]. A bare string crashes startup.
DATABASE_URL=postgresql+asyncpg://firstout:firstout@localhost:5433/firstout
DIRECT_DATABASE_URL=

# Legacy compatibility; Clerk sign-in does not use this secret. A value of at
# least 32 characters can also sign record-workspace selections as a fallback.
JWT_SECRET=

# Preferred server-only key for short-lived record selections and bulk previews.
# Configure the same random value (at least 32 characters) on all API replicas.
# Never use NEXT_PUBLIC_ or commit a real key. If neither this nor a sufficiently
# long JWT_SECRET is configured, browsing works but bulk actions are disabled.
# Rotation invalidates outstanding 15-minute selections/previews; refresh them.
# RECORD_WORKSPACE_SIGNING_KEY=

# Personal MCP tokens use a stable server-only key of at least 32 characters.
# The existing record-workspace key (or its legacy fallback) is used if unset.
# Changing the effective key invalidates every previously issued MCP token.
# MCP token issuance and use also require the Clerk Backend API key below.
# MCP_TOKEN_SIGNING_KEY=
# Set false for read-only MCP access, including pending staff confirmations.
# MCP_WRITES_ENABLED=true
# MCP_PUBLIC_URL=http://localhost:8003/mcp

# Set by the tested backend image build, not a deployment-time override.
# Required by controlled migration/readiness; liveness remains independent.
# SOURCE_COMMIT=<40-character source commit>

# Historical-cookie cleanup uses Secure over HTTPS. Leave false for local HTTP.
COOKIE_SECURE=false

# Origin used for Clerk invitations and onboarding links. Defaults to
# https://app.firstout.co.za; use http://localhost:3003 for local testing.
# PUBLIC_APP_URL=

# Bootstrap owner when the users table is empty (idempotent).
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-owner

# Role fixture records (till/books/warehouse/buyer@example.com), the disabled
# storefront system user, and the Walk-in customer. Off by default so a
# wiped database stays wiped. Owner bootstrap above is unchanged.
SEED_BOOT_FIXTURES=false
SEED_TILL_PASSWORD=change-me-till
SEED_BOOKS_PASSWORD=change-me-books
SEED_WAREHOUSE_PASSWORD=change-me-warehouse
SEED_BUYER_PASSWORD=change-me-buyer

# Demo catalogue/PO path — off by default; set true for a coherent playground dataset.
SEED_PLAYGROUND=false

# Background loop that emails overdue invoices (once per day when enabled in Settings).

# Supplier document reader (OpenRouter) — firstout-api only; never commit a real key.
# Text-layer PDFs are sent as text; photos and scans go to OPENROUTER_DOCUMENT_MODEL.
# OPENROUTER_API_KEY=
# OPENROUTER_DOCUMENT_MODEL=openai/gpt-4o-mini
# Fallback model when OPENROUTER_DOCUMENT_MODEL is empty.
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Required to save or send mail. Set the same value on Railway firstout-api.

# Meta Cloud API webhook verify token (env, not Settings). Same value in the Meta app.

# Private Storefront Ops Commerce read adapter. Leave unset to disable it.
# Bind the token to this operational Team and the expected request hostname.
# OPS_COMMERCE_TOKEN=
# OPS_COMMERCE_COMPANY_ID=
# OPS_COMMERCE_ALLOWED_HOST=
# Adds photo_token to the feed. Turn on only once the commerce release with photo sync is live.
# OPS_COMMERCE_PHOTO_TOKENS_ENABLED=false
# Selects the feed by category, photo and "Hide from shop" and adds shop_category. Turn on only
# once the commerce release with #1018 is live; turn off before rolling commerce back.
# OPS_COMMERCE_AUTO_PUBLISH_ENABLED=false

# Disposable operator exception fixtures for Storefront #755. Leave false outside tests.
# STOREFRONT_EXCEPTION_FIXTURES=false


# Local object storage (filesystem fallback). Files land under STORAGE_DIR relative to backend cwd.
STORAGE_DIR=storage
DEFAULT_STORAGE_USER_ID=firstout

# Object storage (Tigris). When BUCKET_NAME + AWS_* are set, uploads use S3;
# when unset, STORAGE_DIR filesystem fallback. Never reuse Marrow photos / photos-dev.
# AWS_ACCESS_KEY_ID=               # Dedicated bucket credential or Railway reference
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=             # Exact S3 endpoint from the bucket provider
# AWS_REGION=auto
# BUCKET_NAME=

# Clerk is the only interactive authentication provider. Leave disabled until
# the test instance and tenant-isolation activation are configured; no local
# password or cookie fallback is available.
CLERK_ENABLED=false
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=[]
CLERK_WEBHOOK_SECRET=
CLERK_IMPORT_ENABLED=false
CLERK_SECRET_KEY=
# Enable canonical membership reconciliation only after the receiver and key are deployed.
CLERK_WEBHOOK_RECONCILE_ENABLED=false
# Match frontend server-only FRONTEND_PROXY_SECRET; never NEXT_PUBLIC_*.
FRONTEND_PROXY_SECRET=
BILLING_DISABLED=true
BILLING_TEST_MODE=true
TENANT_SIGNUP_ENABLED=false

# Default single-home stage preserves the pre-activation database layout.
# Clerk sign-in is denied until the enforced stage is activated.
TENANT_ISOLATION_MODE=single_home
# After explicit operator activation only, set enforced. That stage requires a
# non-owner NOSUPERUSER NOBYPASSRLS runtime role and FRONTEND_PROXY_SECRET.
# Separate owner connection for Alembic and the operator cutover only.
# MIGRATION_DATABASE_URL=postgresql+asyncpg://migration-role:...@localhost:5433/firstout
# COOKIE_SECURE controls cookie transport only, never the isolation stage.
