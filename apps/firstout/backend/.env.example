# Local only. Never reuse Marrow DATABASE_URL or ht-postgres.
# CORS_ORIGINS is list[str] parsed as JSON — omit it to use the default
# ["http://localhost:3003"]. A bare string crashes startup.
DATABASE_URL=postgresql+asyncpg://firstout:firstout@localhost:5433/firstout
DIRECT_DATABASE_URL=

# Required for login — use a long random string in local .env (not this placeholder).
JWT_SECRET=replace-with-a-long-random-secret

# Set true when serving over HTTPS (Railway). Leave false for local HTTP.
COOKIE_SECURE=false

# Bootstrap owner when the users table is empty (idempotent).
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-owner

# Role logins (till/books/warehouse/buyer@example.com), the disabled
# storefront system user, and the Walk-in customer. Off by default so a
# wiped database stays wiped. Owner bootstrap above is unchanged.
SEED_BOOT_FIXTURES=false
SEED_TILL_PASSWORD=change-me-till
SEED_BOOKS_PASSWORD=change-me-books
SEED_WAREHOUSE_PASSWORD=change-me-warehouse
SEED_BUYER_PASSWORD=change-me-buyer

# Demo catalogue/PO path — off by default; set true for a coherent playground dataset.
SEED_PLAYGROUND=false

# Background loop that emails overdue invoices (once per day when enabled in Settings).
# PAYMENT_REMINDER_TICKER=true

# Fernet key for SMTP/WhatsApp secrets in team_settings. Generate with:
#   uv run --project apps/firstout/backend python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Required to save or send mail. Set the same value on Railway firstout-api.
# SETTINGS_ENCRYPTION_KEY=

# Meta Cloud API webhook verify token (env, not Settings). Same value in the Meta app.
# WA_VERIFY_TOKEN=

# Private Storefront Ops Commerce read adapter. Leave unset to disable it.
# Bind the token to this operational Team and the expected request hostname.
# OPS_COMMERCE_TOKEN=
# OPS_COMMERCE_COMPANY_ID=
# OPS_COMMERCE_ALLOWED_HOST=

# Disposable operator exception fixtures for Storefront #755. Leave false outside tests.
# STOREFRONT_EXCEPTION_FIXTURES=false


# Local object storage (filesystem fallback). Files land under STORAGE_DIR relative to backend cwd.
STORAGE_DIR=storage
DEFAULT_STORAGE_USER_ID=firstout

# Object storage (Tigris). When BUCKET_NAME + AWS_* are set, uploads use S3;
# when unset, STORAGE_DIR filesystem fallback. Never reuse Marrow photos / photos-dev.
# AWS_ACCESS_KEY_ID=               # Tigris (fly storage create) or Railway bucket refs
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# AWS_REGION=auto
# BUCKET_NAME=
