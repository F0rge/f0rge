{
  "name": "firstout-backend",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/firstout/backend",
  "targets": {
    "image": {},
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/firstout/backend",
        "command": "uvx ruff@0.16.1 check ."
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/firstout/backend",
        "command": "uvx ruff@0.16.1 format --check ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/firstout/backend",
        "command": "uv run pytest -ra"
      }
    },
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    },
    "openapi": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/firstout/backend",
        "command": "uv run --locked python scripts/export_openapi.py"
      },
      "outputs": [
        "{projectRoot}/openapi.json",
        "{workspaceRoot}/apps/firstout/frontend/openapi.json"
      ]
    }
  },
  "tags": ["platform:py", "scope:firstout"],
  "metadata": {
    "deploy": {
      "host": "railway",
      "services": [
        {
          "name": "firstout-api",
          "healthcheckPath": "/api/v1/ready",
          "preDeployCommand": "uv run --no-sync python -m app.commands.release_migrate",
          "startCommand": "uv run --no-sync uvicorn app.main:app --host 0.0.0.0 --port 8000"
        }
      ],
      "check": {
        "port": 8000,
        "path": "/api/v1/health",
        "migrate": "uv run --no-sync alembic upgrade head",
        "postgres": "postgres:18",
        "env": { "DATABASE_URL": "postgresql+asyncpg://f0rge:f0rge@postgres:5432/f0rge" }
      }
    }
  }
}
