{
  "name": "firstout-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "next start --port 3003",
    "typecheck": "node ../../../node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "codegen:api": "openapi-typescript openapi.json --default-non-nullable false -o src/lib/generated/api-schema.ts",
    "codegen:check": "npm run codegen:api && git diff --exit-code src/lib/generated/api-schema.ts openapi.json"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.73.0",
    "@carbon/react": "^1.121.0",
    "@carbon/styles": "^1.95.0",
    "@clerk/nextjs": "^7.9.8",
    "@tanstack/react-query": "^5.101.2",
    "barcode-detector": "^3.2.4",
    "jsbarcode": "^3.12.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
