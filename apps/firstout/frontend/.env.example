# Local API; no production credentials belong in this file.
API_URL=http://localhost:8003
# Keep unset to retain legacy-only login. Set both in a Clerk test environment.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Shared server-only HMAC secret, matching backend FRONTEND_PROXY_SECRET.
# Leave both unset for single-home compatibility; coordinate both before enforcement.
FRONTEND_PROXY_SECRET=
# Explicitly permit loopback hosts for a local production-shaped build only.
FIRSTOUT_ALLOW_LOCAL_HOSTS=false
# Enable only after wildcard frontend DNS/TLS is verified; default uses app.firstout.co.za.
NEXT_PUBLIC_TENANT_SUBDOMAINS_ENABLED=false
