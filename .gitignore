node_modules/
.next/
frontend/.env.local

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Cloudflare
.cloudflared/

# Playwright
.playwright*/

# QA screenshots (local agent evidence; not committed)
qa-screenshots/

# Claude agent state — runtime only, never tracked.
# Exception: .claude/agents/ holds project-level sub-agent instructions
# (UX contracts, conventions) that ARE intended to ship in the repo so
# every contributor / future clone gets the same agent behavior.
.claude/*
!.claude/agents/
