# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*.egg

# Session-local MCP config (not committed; per-user)
.mcp.json

# Backend data
backend/photos/
backend/lab_attachments/
backend/.env

# Lab import runtime artifacts
backend/scripts/extraction_audit.jsonl
backend/scripts/import_labs.log

