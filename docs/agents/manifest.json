        "docs/adr/frontend.md"
      ]
    },
    {
      "id": "f0rge-data",
      "profile": "docs/agents/profiles/data.md",
      "description": "App-owned database models, migrations and ETL with explicit tenant and recovery boundaries.",
      "adrFiles": [
        "docs/adr/data.md"
      ]
    },
    {
      "id": "f0rge-security",
      "profile": "docs/agents/profiles/security.md",
      "description": "Dedicated security controls and independent review of identity, permissions, isolation and sensitive-data handling.",
