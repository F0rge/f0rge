# .cursorignore BLOCKS ACCESS — Agent/Tab/Inline-Edit reads and @-mentions all fail.
# Only list things the agent must never read. Anything merely large or low-signal
# belongs in .cursorindexingignore (kept out of the index, still readable on demand).
# Caveat: terminal + MCP tools bypass this. It is not a security boundary.

# Secrets
**/.env
**/.env.*
!**/.env.example
.cloudflared/

# Personal health data (PII)
apps/marrow/backend/photos/
apps/marrow/backend/lab_attachments/

# Dependency and build outputs
node_modules/
.venv/
venv/
.next/
.nx/
dist/
build/
out/
*.tsbuildinfo
*.egg-info/

# Caches
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.eslintcache/
.parcel-cache/
.turbo/
coverage/
htmlcov/
.nyc_output/

# Archives
**/*.zip
**/*.tar
**/*.gz
