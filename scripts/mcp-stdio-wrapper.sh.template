#!/usr/bin/env bash
# mcp-stdio-wrapper.sh — template for adding the health-tracker MCP to Claude
# Code or Claude Desktop in stdio mode.
#
# Usage:
#   cp scripts/mcp-stdio-wrapper.sh.template ~/.local/bin/mcp-stdio-wrapper.sh
#   chmod +x ~/.local/bin/mcp-stdio-wrapper.sh
#   claude mcp add health-tracker --transport stdio -- ~/.local/bin/mcp-stdio-wrapper.sh
#
# The remote runs the container under a name like
# `mcp-server-<coolify-project>-<deploy-id>` (Coolify renames on every
# redeploy and ignores `container_name:` in the compose), so we resolve the
# current container name via `docker ps` each time the wrapper is invoked.
#
# Edit the SSH target below to match your setup (default assumes a `rpi`
# alias in ~/.ssh/config that resolves + auths to the host).
exec ssh leo@rpi 'CONTAINER=$(docker ps --format "{{.Names}}" | grep "^mcp-server-" | head -1); if [ -z "$CONTAINER" ]; then echo "mcp-server container not running on rpi" >&2; exit 1; fi; exec docker exec -i "$CONTAINER" uv run python -m app.mcp --transport stdio'
