#!/usr/bin/env bash
# mcp-stdio-wrapper.sh — template; copy to ~/.local/bin/, chmod +x, edit the SSH host.
#
# Usage from Claude Code:
#   cp scripts/mcp-stdio-wrapper.sh.template ~/.local/bin/mcp-stdio-wrapper.sh
#   chmod +x ~/.local/bin/mcp-stdio-wrapper.sh
#   claude mcp add health-tracker --transport stdio -- ~/.local/bin/mcp-stdio-wrapper.sh
#
# Edit the SSH target below to match your setup (default assumes ~/.ssh/config has a `rpi` alias).
exec ssh leo@rpi -- docker exec -i health-tracker-mcp uv run python -m app.mcp --transport stdio
