PIN_HASH=
VAULT_PATH=/Users/leo/Library/Mobile Documents/iCloud~md~obsidian/Documents/Health-Research
DATABASE_URL=postgresql+asyncpg://health:health@localhost:5432/health
APP_TIMEZONE=Europe/Luxembourg
POSTGRES_PASSWORD=health
SETTINGS_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000
OPENWEATHERMAP_API_KEY=
OPENWEATHERMAP_CITY=Luxembourg
WEATHER_FETCH_ENABLED=true
HEALTH_IMPORT_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
FOOD_ANALYSIS_ENABLED=true

# MCP server (issue #49)
# Long random secret used by Alembic migration 004 to set the role password,
# and by docker-compose.prod.yml to construct MCP_READONLY_DATABASE_URL.
HEALTHTRACKER_RO_PASSWORD=
# asyncpg URL for the read-only role. Used by the MCP server container only.
# Example: postgresql+asyncpg://healthtracker_ro:${HEALTHTRACKER_RO_PASSWORD}@postgres:5432/health
MCP_READONLY_DATABASE_URL=
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8005
EMBEDDING_WORKER_POLL_INTERVAL_SECONDS=5
EMBEDDING_WORKER_BATCH_SIZE=10
EMBEDDING_WORKER_MAX_ATTEMPTS=5
