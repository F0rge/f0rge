{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "packageManager": "npm",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.*",
      "!{projectRoot}/vitest.config.*",
      "!{projectRoot}/jest.config.*",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/e2e/**/*"
    ],
    "sharedGlobals": [],
    "rust": [
      "{projectRoot}/**/*",
      "!{projectRoot}/target/**/*",
      "{workspaceRoot}/**/Cargo.toml",
      "{workspaceRoot}/**/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/rust-toolchain",
      "{workspaceRoot}/.cargo/**/*",
      "{workspaceRoot}/**/.cargo/config.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/.github/rust/**/*",
      {
        "runtime": "rustc -vV"
      }
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/eslint.config.*", "{workspaceRoot}/eslint/**/*"]
    },
    "format-check": {
      "cache": true,
      "inputs": ["default"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "codegen:check": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "e2e": {
      "cache": false
    }
  },
  "sync": {
    "globalGenerators": ["@nxlv/python:pkg-sync"]
  },
  "plugins": [
    {
      "plugin": "@nx/next/plugin",
      "options": {
        "startTargetName": "start",
        "buildTargetName": "build",
        "devTargetName": "dev"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "targetName": "test"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e",
        "ciTargetName": "e2e-ci"
      }
    },
    {
      "plugin": "@nxlv/python",
      "options": {
        "packageManager": "uv",
        "inferDependencies": true
      }
    }
  ]
}
